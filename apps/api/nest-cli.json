{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "core/i18n/translate/**/*", "outDir": "dist/src/", "watchAssets": true },
      { "include": "core/queue/mail/*.hbs", "outDir": "dist/src/", "watchAssets": true}

    ]
  }
}
