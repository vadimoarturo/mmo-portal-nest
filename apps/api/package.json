{
  "name": "api",
  "version": "0.0.1",
  "description": "MMORPG community portal API: accounts, commerce, auctions, rankings, and payment integrations",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "prisma:generate": "pnpm prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prebuild": "pnpm prisma:generate",
    "pretest": "pnpm prisma:generate",
    "typecheck": "pnpm prisma:generate && tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@liaoliaots/nestjs-redis": "^10.0.0",
    "@nestjs-modules/mailer": "^2.3.10",
    "@nestjs/bull": "^11.0.5",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cookie-parser": "^1.4.7",
    "decimal.js": "10.6.0",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "joi": "^18.3.1",
    "md5": "^2.3.0",
    "moment-timezone": "^0.6.6",
    "nestjs-throttler-storage-redis": "^0.5.1",
    "nodemailer": "^10.3.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql-formatter": "^15.9.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/md5": "^2.3.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.12",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#Root/(.*)$": "<rootDir>/$1"
    }
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "imports": {
    "#Root/*": "./dist/src/*.js"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "multer": "^2.5.0",
      "nodemailer": "^10.3.1",
      "glob": "^14.0.2",
      "minimatch": "^11.0.1",
      "bull>uuid": "^11.1.1"
    }
  }
}
