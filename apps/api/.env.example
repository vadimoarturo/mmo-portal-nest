# Local development. Copy to .env and fill every empty secret.
APP_PORT=3010
WEB_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate three independent values: openssl rand -hex 32
JWT_SECRET_ACCESS=
JWT_SECRET_ACCESS_EXPIRESIN=15m
JWT_SECRET_REFRESH=
JWT_SECRET_REFRESH_EXPIRESIN=7d
JWT_SECRET_VERIFY=
JWT_SECRET_VERIFY_EXPIRESIN=15m

# Both catalogs must be on the SAME SQL Server instance for atomic commerce.
# Use your own SQL credentials. Braces escape punctuation in JDBC values.
DATABASE_URL="sqlserver://localhost:1433;database=Portal;user=portal_app;password={CHANGE_ME};encrypt=true;trustServerCertificate=true"
DATABASE_URLMMO="sqlserver://localhost:1433;database=GameWorld;user=portal_app;password={CHANGE_ME};encrypt=true;trustServerCertificate=true"

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=

# The seed keeps payment methods disabled. Configure real credentials before enabling.
FREEKASSA_SHOP_ID=1
FREEKASSA_SECRET_ONE=
FREEKASSA_SECRET_TWO=
ANYPAY_SHOP_ID=1
ANYPAY_SECRET=
ENOT_SHOP_ID=example-shop
ENOT_SECRET_ONE=
ENOT_SECRET_TWO=
