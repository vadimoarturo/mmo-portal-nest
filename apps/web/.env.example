# Public browser origin of the API; /api is added by the HTTP client.
# Next.js inlines NEXT_PUBLIC_* during build. Never place secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3010

# Optional community and client download links. Blank values hide those links.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=
NEXT_PUBLIC_CLIENT_TORRENT_URL=
