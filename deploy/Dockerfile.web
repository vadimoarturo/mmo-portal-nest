FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --global pnpm@9.4.0
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:8080
ARG NEXT_PUBLIC_DISCORD_URL=
ARG NEXT_PUBLIC_TELEGRAM_URL=
ARG NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=
ARG NEXT_PUBLIC_CLIENT_TORRENT_URL=
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_DISCORD_URL=$NEXT_PUBLIC_DISCORD_URL
ENV NEXT_PUBLIC_TELEGRAM_URL=$NEXT_PUBLIC_TELEGRAM_URL
ENV NEXT_PUBLIC_CLIENT_DOWNLOAD_URL=$NEXT_PUBLIC_CLIENT_DOWNLOAD_URL
ENV NEXT_PUBLIC_CLIENT_TORRENT_URL=$NEXT_PUBLIC_CLIENT_TORRENT_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
USER node
EXPOSE 3000
CMD ["node", "server.js"]
